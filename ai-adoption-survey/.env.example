# Supabase (ローカル開発: `supabase start` の出力値を設定)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (メール送信。未設定の場合はメール送信をスキップしてログ出力のみ)
RESEND_API_KEY=
EMAIL_FROM=AI活用レベル診断 <noreply@example.com>

# アプリ
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 「無料相談を予約する」CTAのリンク先
NEXT_PUBLIC_CONSULTATION_URL=https://digirise.ai/contact/

# Vercel Cron の認証用シークレット(ランダム文字列を設定)
CRON_SECRET=
