# Anthropicコンソール( https://platform.claude.com/ )で発行したAPIキー
ANTHROPIC_API_KEY=sk-ant-...

# 社員に共有するパスワード(任意の文字列)
APP_PASSWORD=

# WordPress(digirise.ai)の導入事例 自動下書き作成APIのキー。
# WordPress側担当者(清水さん)から共有された値を設定する。
# これが無い場合、「WordPressへ下書き保存」機能だけが使えない(原稿生成は動く)
WP_CASE_API_KEY=

# WordPress APIのベースURL(通常は変更不要)
# WP_API_BASE=https://digirise.ai/wp-json/digirise/v1

# 大きいPDF(3.5MB超)対応用。VercelでBlobストアを作成すると自動設定される
# BLOB_READ_WRITE_TOKEN=
