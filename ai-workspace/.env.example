# ===== 必須 =====
# Anthropic APIキー（https://platform.claude.com で発行）
ANTHROPIC_API_KEY=sk-ant-xxxxx

# 初回起動時に作成される管理者アカウント
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=管理者

# ===== 任意 =====
# サーバーポート
PORT=3100

# セッション署名キー（未設定なら起動時に自動生成。再起動でログアウトさせたくない場合は固定する）
SESSION_SECRET=

# 1ユーザーあたりの月次APIコスト上限（円）。超えると当月は利用停止。
# 1ID=1,000円で販売する場合、500円なら粗利50%以上を保証（実際の平均利用はこれを大きく下回る想定）
DEFAULT_MONTHLY_BUDGET_JPY=500

# 円換算レート（APIコスト計算用）
USD_JPY_RATE=155

# 上位モデル（Claude Opus 4.8）を許可するか。true にすると「高度な分析」モードが使える
ENABLE_ADVANCED_MODEL=false
